[Unit]
Description=Gunicorn instance to serve Flask app
After=network.target

[Service]
User=server
Group=www-data
WorkingDirectory=/home/server/Website
Environment="PATH=/home/server/Website/venv/bin"
EnvironmentFile=/home/server/Website/.env
ExecStart=/home/server/Website/venv/bin/gunicorn -c gunicorn.conf.py wsgi:app

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
